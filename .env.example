# همه اختیاری هستند (روی Runflare در بخش Environment Variables وارد کنید)
# PORT=3000                      # معمولاً خود Runflare تنظیم می‌کند
# DATA_DIR=/data                 # مسیر دیسک دائمی (خیلی مهم، توضیح در README.md)
# PUBLIC_URL=https://panel.example.ir   # فقط اگر لینک‌های ساخته‌شده http یا آدرس اشتباه شدند
# WS_DEFLATE=1                   # فشرده‌سازی WebSocket (پهنای باند کمتر، مصرف CPU بیشتر)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# TOKENHARBOR_API_KEY=
